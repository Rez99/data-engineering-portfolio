        {
          "datasource": {
            "type": "postgres",
            "uid": "clickstream-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH bounds AS (SELECT date_bin('5 minutes', $__timeFrom()::timestamp, timestamp '1970-01-01') AS start_time, date_bin('5 minutes', $__timeTo()::timestamp, timestamp '1970-01-01') AS end_time), buckets AS (SELECT generate_series(start_time, end_time, interval '5 minutes') AS time FROM bounds), metrics AS (SELECT date_bin('5 minutes', window_end, timestamp '1970-01-01') AS time, SUM(active_sessions) AS active_sessions, SUM(bot_sessions) AS bot_sessions FROM stream_bot_metrics WHERE $__timeFilter(window_end) GROUP BY 1) SELECT buckets.time, CASE WHEN metrics.active_sessions IS NULL THEN 0.0 WHEN metrics.active_sessions >= 100 THEN metrics.bot_sessions::double precision / metrics.active_sessions ELSE NULL END AS \"Bot rate\" FROM buckets LEFT JOIN metrics USING (time) ORDER BY buckets.time;",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "clickstream-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH bounds AS (SELECT date_bin('5 minutes', $__timeFrom()::timestamp, timestamp '1970-01-01') AS start_time, date_bin('5 minutes', $__timeTo()::timestamp, timestamp '1970-01-01') AS end_time), buckets AS (SELECT generate_series(start_time, end_time, interval '5 minutes') AS time FROM bounds), metrics AS (SELECT date_bin('5 minutes', window_end, timestamp '1970-01-01') AS time, SUM(active_sessions) AS active_sessions, SUM(bot_sessions) AS bot_sessions FROM stream_bot_metrics WHERE $__timeFilter(window_end) GROUP BY 1), filled AS (SELECT buckets.time, CASE WHEN metrics.active_sessions IS NULL THEN 0.0 WHEN metrics.active_sessions >= 100 THEN metrics.bot_sessions::double precision / metrics.active_sessions ELSE NULL END AS bot_rate FROM buckets LEFT JOIN metrics USING (time)) SELECT time, AVG(bot_rate) OVER (ORDER BY time ROWS BETWEEN 11 PRECEDING AND CURRENT ROW) AS \"Bot rate 12-window MA\" FROM filled ORDER BY time;",
          "refId": "B"
        }
      ],
      "title": "Bot Rate Over Time",
      "type": "timeseries"
