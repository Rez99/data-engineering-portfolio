          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT score_histogram FROM stream_bot_metrics ORDER BY window_end DESC LIMIT 1) SELECT '0.0-0.2' AS bucket, COALESCE(NULLIF(split_part(split_part(score_histogram, '0.0-0.2=', 2), ',', 1), '')::int, 0) AS sessions FROM latest UNION ALL SELECT '0.2-0.4', COALESCE(NULLIF(split_part(split_part(score_histogram, '0.2-0.4=', 2), ',', 1), '')::int, 0) FROM latest UNION ALL SELECT '0.4-0.6', COALESCE(NULLIF(split_part(split_part(score_histogram, '0.4-0.6=', 2), ',', 1), '')::int, 0) FROM latest UNION ALL SELECT '0.6-0.8', COALESCE(NULLIF(split_part(split_part(score_histogram, '0.6-0.8=', 2), ',', 1), '')::int, 0) FROM latest UNION ALL SELECT '0.8-1.0', COALESCE(NULLIF(split_part(score_histogram, '0.8-1.0=', 2), '')::int, 0) FROM latest;",
          "refId": "A"
        }
